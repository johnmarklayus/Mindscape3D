# Copy to .env.local for local work; set the same names in Vercel > Project > Settings > Environment Variables.

# The site's public address, used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where the WebGL game files live. Default "/game" = this site's public/game folder (filled by `npm run sync-game`).
# Point it at another host (with CORS + "Content-Encoding: br" on the .br files) to keep the game out of this deploy.
NEXT_PUBLIC_GAME_URL=/game

# Download links. A platform without a link shows "Coming soon".
# Builds over 100 MB can't be uploaded to Vercel, so host them on GitHub Releases, Google Drive, a CDN or storage bucket.
NEXT_PUBLIC_DOWNLOAD_WINDOWS=
NEXT_PUBLIC_DOWNLOAD_MACOS=
NEXT_PUBLIC_DOWNLOAD_ANDROID=

# Contact form: messages are e-mailed through Resend (https://resend.com). Without these the form shows an error
# and points people to CONTACT_PUBLIC_EMAIL instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="MindScape 3D <noreply@your-domain.com>"
NEXT_PUBLIC_CONTACT_EMAIL=
